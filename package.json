{
  "name": "arrow-render-to-string",
  "version": "0.0.4",
  "repository": "git@github.com:dumbjs/arrow-render-to-string.git",
  "license": "MIT",
  "author": "Reaper <ahoy@barelyhuman.dev>",
  "main": "./index.js",
  "module": "./index.mjs",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.js",
      "types": "./index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "bench": "npm run build; node bench/index.js",
    "dev": "tsdown --watch",
    "next": "bumpp",
    "fix": "prettier --write .",
    "test": "uvu tests",
    "test:ci": "c8 uvu tests ",
    "prepare": "husky install"
  },
  "publishConfig": {
    "access": "public"
  },
  "prettier": "@barelyhuman/prettier-config",
  "devDependencies": {
    "@barelyhuman/prettier-config": "^2.0.2",
    "benchmark": "^2.1.4",
    "bumpp": "^11.0.1",
    "c8": "^11.0.0",
    "esm": "^3.2.25",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "pretty-bytes": "^7.1.0",
    "systeminformation": "^5.31.5",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "uvu": "^0.5.6",
    "uvu-inline-snapshot": "^0.0.4"
  },
  "lint-staged": {
    "*.{js,css,md,json}": "prettier --write"
  },
  "peerDependencies": {
    "@arrow-js/core": "^1.0.0-alpha.9"
  }
}
